# Existing Google authentication and PostgreSQL configuration
DATABASE_URL=postgresql://user:password@localhost:5432/chalk
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Local origin here; set this to your HTTPS app origin in production.
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Server-only tutor integration. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=your-openai-api-key
OPENAI_TEXT_MODEL=gpt-5.4-mini

# Private Vercel Blob store for saved narration (server-only)
BLOB_READ_WRITE_TOKEN=
